{
  "profile_id": "contrato-mensual",
  "version": "1.0.0",
  "kind": "delimited",
  "description": "Contrato mínimo para un CSV mensual sintético: una fila por año, mes e indicador.",
  "columns": [
    { "key": "year", "header": "anio", "type": "integer", "role": "period_year" },
    { "key": "month", "header": "mes", "type": "integer", "role": "period_month" },
    { "key": "indicator", "header": "indicador", "type": "string" },
    { "key": "value", "header": "valor", "type": "number", "role": "index", "base": "2025=100", "unit": "índice" },
    { "key": "unit", "header": "unidad", "type": "string" }
  ],
  "grain": ["year", "month", "indicator"],
  "unit": "indice",
  "unit_column": "unit",
  "period": {
    "year_column": "year",
    "month_column": "month",
    "expected": [
      { "year": 2025, "month": 1 },
      { "year": 2025, "month": 2 },
      { "year": 2025, "month": 3 }
    ]
  },
  "display": {
    "period": "enero a marzo de 2025",
    "base": "2025=100 (serie sintética, no es una base oficial)",
    "unit": "índice"
  }
}
