# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.venv

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# testing
/coverage

# next.js
/web/.next/
/web/out/
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cache
.cache
.eslintcache
.turbo
.swc

# Descubrimiento INE (datos crudos, temporales)
/discovery_ine/

# Datos crudos descargados por `uv run radar build`
/data/raw/*.xlsx
/data/raw/*.part
/data/reference/*.geojson
