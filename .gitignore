# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cache
.cache
.eslintcache
.turbo
.swc

# Descubrimiento INE (datos crudos, temporales)
/discovery_ine/

# Python (uv)
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Next.js / pnpm (web/)
web/node_modules/
web/.next/
web/out/
web/.turbo/
web/.env*.local
web/next-env.d.ts

# Generated data artifacts that are intentionally committed:
# data/raw/, data/processed/*.parquet, data/provenance/, web/data/
# Do not add them here: the app is designed to run offline from the cache.
